/S/Span<</ActualText(\040\040\\overline\040{\\mathbf\040{x}}_{C,j}\040&=\040\\begin\040{bmatrix}\040r_{11}\040&\040r_{12}\040&\040r_{13}\\\\\040r_{21}\040&\040r_{22}\040&\040r_{23}\\\\\040r_{31}\040&\040r_{32}\040&\040r_{33}\040\\end\040{bmatrix}\040\\cdot\040\\begin\040{bmatrix}\040\\frac\040{z_{C,i}}{b_{L,i}}\040\\left\040\(\040x_{V,i}'\040-\040c_x\040\\right\040\)\040s_x\\\\\040\\frac\040{z_{C,i}}{b_{L,i}}\040\\left\040\(\040y_{V,i}'\040-\040c_y\040\\right\040\)\040s_y\\\\\040\\left\040\(\\frac\040{1}{f_L}-\\frac\040{1}{b_{L,i}}\\right\040\)^{-1}\040\\end\040{bmatrix}\040+\040\\begin\040{bmatrix}\040t_x\\\\\040t_y\\\\\040t_z\040\\end\040{bmatrix}\040\\nonumber\040\\\\\040\\Leftrightarrow\040\\qquad\040\\overline\040{\\mathbf\040{x}}_{C,j}\040&=\040\\begin\040{bmatrix}\040x_{C,j}\\\\\040y_{C,j}\\\\\040z_{C,j}\040\\end\040{bmatrix}\040=\040\\begin\040{bmatrix}\040r_{11}\040&\040r_{12}\040&\040r_{13}\\\\\040r_{21}\040&\040r_{22}\040&\040r_{23}\\\\\040r_{31}\040&\040r_{32}\040&\040r_{33}\040\\end\040{bmatrix}\040\\cdot\040\\begin\040{bmatrix}\040\\frac\040{1}{b_{L,i}\040\\cdot\040\\rho\040_{C,i}}\040\\left\040\(\040x_{V,i}'\040-\040c_x\040\\right\040\)\040s_x\\\\\040\\frac\040{1}{b_{L,i}\040\\cdot\040\\rho\040_{C,i}}\040\\left\040\(\040y_{V,i}'\040-\040c_y\040\\right\040\)\040s_y\\\\\040\\frac\040{1}{\\rho\040_{C,i}}\040\\end\040{bmatrix}\040+\040\\begin\040{bmatrix}\040t_x\\\\\040t_y\\\\\040t_z\040\\end\040{bmatrix}\040\\nonumber\040\\\\\040\\Leftrightarrow\040\\qquad\040\\begin\040{bmatrix}\040x_{C,j}\\\\\040y_{C,j}\\\\\040z_{C,j}\040\\end\040{bmatrix}\040&=\040\\begin\040{bmatrix}\040r_{11}\040\\frac\040{s_x}{b_{L,i}\040\\rho\040_{C,i}}\040\\left\040\(\040x_{V,i}'\040-\040c_x\040\\right\040\)\040+\040r_{12}\040\\frac\040{s_y}{b_{L,i}\040\\rho\040_{C,i}}\040\\left\040\(\040y_{V,i}'\040-\040c_y\040\\right\040\)\040+\040r_{13}\040\\frac\040{1}{\\rho\040_{C,i}}\040+\040t_x\\\\\040r_{21}\040\\frac\040{s_x}{b_{L,i}\040\\rho\040_{C,i}}\040\\left\040\(\040x_{V,i}'\040-\040c_x\040\\right\040\)\040+\040r_{22}\040\\frac\040{s_y}{b_{L,i}\040\\rho\040_{C,i}}\040\\left\040\(\040y_{V,i}'\040-\040c_y\040\\right\040\)\040+\040r_{23}\040\\frac\040{1}{\\rho\040_{C,i}}\040+\040t_y\\\\\040r_{31}\040\\frac\040{s_x}{b_{L,i}\040\\rho\040_{C,i}}\040\\left\040\(\040x_{V,i}'\040-\040c_x\040\\right\040\)\040+\040r_{32}\040\\frac\040{s_y}{b_{L,i}\040\\rho\040_{C,i}}\040\\left\040\(\040y_{V,i}'\040-\040c_y\040\\right\040\)\040+\040r_{33}\040\\frac\040{1}{\\rho\040_{C,i}}\040+\040t_z\040\\end\040{bmatrix}.\040\\label\040{eq:Xc2AsFunctionOfd1})>>BDC
