/S/Span<</ActualText(\040\040\\begin\040{split}\040\\frac\040{\\partial\040\\mathbf\040{x}_{C,j}}{\\partial\040\\boldsymbol\040{\\xi\040}_i}\040&=\040\\lim\040_{\\boldsymbol\040{\\xi\040}_i\040\\to\0400}\040\\frac\040{e^{\\hat\040{\\boldsymbol\040{\\xi\040}}_i}\040\\cdot\040\\mathbf\040{x}_{C,j}\040-\040\\mathbf\040{x}_{C,j}}{\\boldsymbol\040{\\xi\040}_i}\040=\040\\lim\040_{\\boldsymbol\040{\\xi\040}_i\040\\to\0400}\040\\frac\040{\040\\left\040\(\040I\040+\040\\hat\040{\\boldsymbol\040{\\xi\040}}_i\040\\right\040\)\040\\cdot\040\\mathbf\040{x}_{C,j}\040-\040\\mathbf\040{x}_{C,j}}{\\boldsymbol\040{\\xi\040}_i}\\\\\040&=\040\\lim\040_{\\boldsymbol\040{\\xi\040}_i\040\\to\0400}\040\\frac\040{\040\\hat\040{\\boldsymbol\040{\\xi\040}}_i\040\\cdot\040\\mathbf\040{x}_{C,j}}{\\boldsymbol\040{\\xi\040}_i}\040=\040\\lim\040_{\\boldsymbol\040{\\xi\040}_i\040\\to\0400}\040\\frac\040{\040\\begin\040{bmatrix}\040\\hat\040w\040&\040v\\\\\0400\040&\0400\040\\end\040{bmatrix}\040\\cdot\040\\begin\040{bmatrix}\040\\mathbf\040{x}_{C,j}\\\\\0401\040\\end\040{bmatrix}}{\\boldsymbol\040{\\xi\040}_i}\\\\\040&=\040\\lim\040_{\\boldsymbol\040{\\xi\040}_i\040\\to\0400}\040\\frac\040{1}{\\boldsymbol\040{\\xi\040}_i}\040\\cdot\040\\begin\040{bmatrix}\040\\hat\040w\040&\040v\\\\\0400\040&\0400\040\\end\040{bmatrix}\040\\cdot\040\\begin\040{bmatrix}\040\\mathbf\040{x}_{C,j}\\\\\0401\040\\end\040{bmatrix}\\\\\040&=\040\\lim\040_{\\boldsymbol\040{\\xi\040}_i\040\\to\0400}\040\\frac\040{1}{\\boldsymbol\040{\\xi\040}_i}\040\\cdot\040\\begin\040{bmatrix}\0400\040&\040-\\omega\040_3\040&\040\\omega\040_2\040&\040t_1\\\\\040\\omega\040_3\040&\0400\040&\040-\\omega\040_1\040&\040t_2\\\\\040-\\omega\040_2\040&\040\\omega\040_1\040&\0400\040&\040t_3\\\\\0400\040&\0400\040&\0400\040&\0401\040\\end\040{bmatrix}\040\\cdot\040\\begin\040{bmatrix}\040x_{C,j}\\\\\040y_{C,j}\\\\\040z_{C,j}\\\\\0401\040\\end\040{bmatrix}\\\\\040&=\040\\lim\040_{\\boldsymbol\040{\\xi\040}_i\040\\to\0400}\040\\frac\040{1}{\\boldsymbol\040{\\xi\040}_i}\040\\cdot\040\\begin\040{bmatrix}\040-\\omega\040_3\040\\cdot\040y_{C,j}\040+\040\\omega\040_2\040\\cdot\040z_{C,j}\040+\040t_1\\\\\040\\omega\040_3\040\\cdot\040x_{C,j}\040-\040\\omega\040_1\040\\cdot\040z_{C,j}\040+\040t_2\\\\\040-\\omega\040_2\040\\cdot\040x_{C,j}\040+\040\\omega\040_1\040\\cdot\040y_{C,j}\040+\040t_3\\\\\0401\040\\end\040{bmatrix}\040\\end\040{split}\040\\label\040{eq:dxCj_dxii})>>BDC
